    {
      "key": "set_profile",
      "label": {
        "en": "Set the ventilation profile",
        "fr": "Changer le profil de ventilation",
        "de": "Lüftungsprofil setzen",
        "es": "Cambiar el perfil de ventilación"
      },
      "description": {
        "en": "Home, away, boost or fireplace. Boost and fireplace run for the given minutes, or the unit default.",
        "fr": "Maison, absence, boost ou cheminée. Boost et cheminée durent le nombre de minutes donné, ou la durée réglée sur la centrale.",
