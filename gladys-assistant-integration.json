{
  "manifest_version": 1,
  "type": "device",
  "name": "Vallox",
  "description": {
    "en": "Control your Vallox heat recovery ventilation unit locally: profiles, fans, temperatures.",
    "fr": "Pilotez votre VMC double flux Vallox en local : profils, ventilation, températures.",
    "de": "Steuere dein Vallox-Lüftungsgerät lokal: Profile, Lüfter und Temperaturen.",
    "es": "Controle su unidad de ventilación Vallox en local: perfiles, ventilación, temperaturas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/prohand/gladys-vallox:1.0.1",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-vallox/main/cover.png",
  "categories": ["climate", "environment"],
  "keywords": [
    "valloplus",
    "vallomulti",
    "vallox mv",
    "helios kwl",
    "vmc double flux",
    "mvhr",
    "heat recovery",
    "ventilation",
    "lüftungsanlage",
    "ventilación"
  ],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "The integration talks to the unit directly on your local network, like the Vallox web interface does: no cloud account. Give the unit a fixed IP address in your router, check that you can open http://<that address> in a browser, then type the address below.",
        "fr": "L'intégration parle directement à la centrale sur votre réseau local, comme l'interface web Vallox : aucun compte cloud. Donnez une adresse IP fixe à la centrale dans votre box, vérifiez que http://<cette adresse> s'ouvre dans un navigateur, puis saisissez l'adresse ci-dessous.",
        "de": "Die Integration spricht direkt im lokalen Netzwerk mit dem Gerät, so wie die Vallox-Weboberfläche: kein Cloud-Konto. Gib dem Gerät in deinem Router eine feste IP-Adresse, prüfe, dass sich http://<diese Adresse> im Browser öffnet, und trage die Adresse unten ein.",
        "es": "La integración habla directamente con la unidad en su red local, como la interfaz web de Vallox: sin cuenta en la nube. Asigne una dirección IP fija a la unidad en su router, compruebe que http://<esa dirección> se abre en un navegador y escriba la dirección abajo."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-vallox/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "IP address of the unit",
        "fr": "Adresse IP de la centrale",
        "de": "IP-Adresse des Geräts",
        "es": "Dirección IP de la unidad"
      },
      "description": {
        "en": "Several units: separate their addresses with commas.",
        "fr": "Plusieurs centrales : séparez leurs adresses par des virgules.",
        "de": "Mehrere Geräte: Trenne ihre Adressen durch Kommas.",
        "es": "Varias unidades: separe sus direcciones con comas."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the unit is read, in seconds (15 to 3600).",
        "fr": "Fréquence de lecture de la centrale, en secondes (15 à 3600).",
        "de": "Wie oft das Gerät gelesen wird, in Sekunden (15 bis 3600).",
        "es": "Cada cuánto se lee la unidad, en segundos (15 a 3600)."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 3600
    },
    {
      "key": "filter_warning_days",
      "type": "number",
      "label": {
        "en": "Filter warning (days)",
        "fr": "Alerte filtre (jours)",
        "de": "Filterwarnung (Tage)",
        "es": "Aviso de filtro (días)"
      },
      "description": {
        "en": "The \"Filter change due\" scene trigger fires when the filter life left reaches this number of days.",
        "fr": "Le déclencheur de scène « Changement de filtre à prévoir » se déclenche quand la durée de vie restante du filtre atteint ce nombre de jours.",
        "de": "Der Szenenauslöser „Filterwechsel fällig“ löst aus, wenn die Restlaufzeit des Filters diese Anzahl Tage erreicht.",
        "es": "El disparador de escena «Cambio de filtro próximo» se activa cuando la vida restante del filtro llega a este número de días."
      },
      "required": false,
      "default": 14,
      "min": 0,
      "max": 90
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    },
    {
      "key": "reset_filter_reminder",
      "label": {
        "en": "Filters changed today",
        "fr": "Filtres changés aujourd'hui",
        "de": "Filter heute gewechselt",
        "es": "Filtros cambiados hoy"
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "reset_filter_intro",
          "type": "section",
          "label": {
            "en": "Restart the filter reminder",
            "fr": "Relancer le rappel de filtre",
            "de": "Filtererinnerung neu starten",
            "es": "Reiniciar el recordatorio de filtro"
          },
          "description": {
            "en": "Records a filter change made today: the unit counts its next reminder from today.",
            "fr": "Enregistre un changement de filtre fait aujourd'hui : la centrale compte son prochain rappel à partir d'aujourd'hui.",
            "de": "Erfasst einen heute durchgeführten Filterwechsel: Das Gerät zählt die nächste Erinnerung ab heute.",
            "es": "Registra un cambio de filtro hecho hoy: la unidad cuenta su próximo recordatorio a partir de hoy."
          }
        },
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Unit",
            "fr": "Centrale",
            "de": "Gerät",
            "es": "Unidad"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "profile_changed",
      "label": {
        "en": "Ventilation profile changed",
        "fr": "Le profil de ventilation a changé",
        "de": "Lüftungsprofil geändert",
        "es": "Ha cambiado el perfil de ventilación"
      },
      "description": {
        "en": "The unit switched profile (home, away, boost, fireplace…), from its panel, its app or a timer. Gladys own orders never fire it.",
        "fr": "La centrale a changé de profil (maison, absence, boost, cheminée…), depuis son panneau, son appli ou une minuterie. Les ordres de Gladys ne le déclenchent jamais.",
        "de": "Das Gerät hat das Profil gewechselt (Zuhause, Abwesend, Boost, Kamin…), über sein Bedienteil, seine App oder einen Timer. Befehle von Gladys selbst lösen dies nie aus.",
        "es": "La unidad ha cambiado de perfil (en casa, ausente, boost, chimenea…), desde su panel, su app o un temporizador. Las propias órdenes de Gladys nunca lo activan."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
